# Global Monorepo Gitignore

# Dependencies
node_modules/
/backend/node_modules/
/backend/vendor/
/front/node_modules/

# Local env files
.env
.env*.local
/backend/.env
/backend/.env.backup
/backend/.env.production
/front/.env*.local

# Build outputs
/front/.next/
/front/out/
/front/build/
/backend/public/storage
/backend/public/build
/backend/public/hot

# IDEs and Editors
.idea/
.vscode/
.fleet/
.nova/
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Misc
*.log
.phpunit.result.cache
.phpunit.cache/
/backend/storage/*.key
/backend/storage/pail
